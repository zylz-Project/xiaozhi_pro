# Offline product voices replace existing basenames, never add duplicate linker
# symbols. gen_lang.py still generates the same Lang::Sounds names; no speech is
# generated by CMake. Included only by WZH builds with explicit pack opt-in.
if(CONFIG_BOARD_TYPE_WZH_DINOSAUR)
    set(WZH_SYSTEM_VOICE_PROFILE "dinosaur")
else()
    set(WZH_SYSTEM_VOICE_PROFILE "panda")
endif()
get_filename_component(WZH_SYSTEM_VOICE_ROOT "${CONFIG_WZH_SYSTEM_PROMPT_ROOT}"
                       ABSOLUTE BASE_DIR "${PROJECT_DIR}")
set(WZH_SYSTEM_VOICE_DIR "${WZH_SYSTEM_VOICE_ROOT}/${WZH_SYSTEM_VOICE_PROFILE}")
file(GLOB WZH_SYSTEM_VOICE_FILES "${WZH_SYSTEM_VOICE_DIR}/*.ogg")

if(NOT CMAKE_BUILD_EARLY_EXPANSION)
    set(WZH_SYSTEM_VOICE_VALIDATE_ARGS "")
    if(CONFIG_WZH_SYSTEM_PROMPT_ALLOW_ALTERNATIVE)
        list(APPEND WZH_SYSTEM_VOICE_VALIDATE_ARGS --allow-alternative)
    endif()
    execute_process(
        COMMAND python3 "${PROJECT_DIR}/scripts/audio/prepare_wzh_system_prompts.py"
                --validate --profile "${WZH_SYSTEM_VOICE_PROFILE}"
                --output "${WZH_SYSTEM_VOICE_DIR}" ${WZH_SYSTEM_VOICE_VALIDATE_ARGS}
        RESULT_VARIABLE WZH_SYSTEM_VOICE_RESULT
        OUTPUT_VARIABLE WZH_SYSTEM_VOICE_OUTPUT
        ERROR_VARIABLE WZH_SYSTEM_VOICE_ERROR
    )
    if(NOT WZH_SYSTEM_VOICE_RESULT EQUAL 0)
        message(FATAL_ERROR "Product system-voice pack rejected: ${WZH_SYSTEM_VOICE_ERROR}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${WZH_SYSTEM_VOICE_DIR}/pack.json"
        "${PROJECT_DIR}/main/assets/wzh_system_prompts.json"
        "${PROJECT_DIR}/scripts/audio/prepare_wzh_system_prompts.py"
        ${WZH_SYSTEM_VOICE_FILES})
endif()

foreach(VOICE_FILE IN LISTS WZH_SYSTEM_VOICE_FILES)
    get_filename_component(VOICE_NAME "${VOICE_FILE}" NAME)
    set(VOICE_REPLACED FALSE)
    foreach(SOUND_LIST LANG_SOUNDS COMMON_SOUNDS)
        foreach(ORIGINAL_FILE IN LISTS ${SOUND_LIST})
            get_filename_component(ORIGINAL_NAME "${ORIGINAL_FILE}" NAME)
            if(ORIGINAL_NAME STREQUAL VOICE_NAME)
                list(REMOVE_ITEM ${SOUND_LIST} "${ORIGINAL_FILE}")
                list(APPEND ${SOUND_LIST} "${VOICE_FILE}")
                set(VOICE_REPLACED TRUE)
            endif()
        endforeach()
    endforeach()
    if(NOT VOICE_REPLACED)
        message(FATAL_ERROR "Unknown product prompt basename: ${VOICE_NAME}")
    endif()
endforeach()
