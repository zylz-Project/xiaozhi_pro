<!DOCTYPE html>
<html>
<head>
    <title>@WZH_PAGE_TITLE@</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <style>
        :root {
            --accent: @WZH_ACCENT@;
            --accent-hover: @WZH_ACCENT_HOVER@;
            --accent-soft: @WZH_ACCENT_SOFT@;
            --blob: @WZH_ACCENT_SOFT@;
            --bg-grad-1: @WZH_BG_1@;
            --bg-grad-2: @WZH_BG_2@;
            --surface: #ffffff;
            --border: #e8edf4;
            --text: #1e293b;
            --text-muted: #64748b;
            --shadow: 0 1px 2px rgba(30, 41, 59, 0.05), 0 16px 36px -16px @WZH_ACCENT_SOFT@;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --accent: @WZH_ACCENT_DARK@;
                --accent-hover: @WZH_ACCENT_HOVER_DARK@;
                --accent-soft: @WZH_ACCENT_SOFT_DARK@;
                --blob: @WZH_ACCENT_SOFT_DARK@;
                --bg-grad-1: #0b1220;
                --bg-grad-2: #111827;
                --surface: #1e293b;
                --border: #334155;
                --text: #e2e8f0;
                --text-muted: #94a3b8;
                --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 16px 36px -16px rgba(0, 0, 0, 0.5);
            }
        }

        * { box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            margin: 0;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Helvetica, Arial, sans-serif;
            color: var(--text);
            background:
                radial-gradient(720px 480px at 112% -8%, var(--blob), transparent 60%),
                radial-gradient(640px 460px at -18% 108%, var(--blob), transparent 55%),
                linear-gradient(160deg, var(--bg-grad-1), var(--bg-grad-2));
            -webkit-font-smoothing: antialiased;
        }

        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            max-height: 100vh;
            padding: 24px;
        }

        .card {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 22px;
            box-shadow: var(--shadow);
            padding: 40px 36px 34px;
            max-width: 360px;
            width: 100%;
        }

        .checkmark {
            width: 96px;
            height: 96px;
            margin-bottom: 22px;
        }
        .checkmark__circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke: var(--accent);
            fill: none;
            animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }
        .checkmark__check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            stroke: var(--accent);
            animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
        }

        @keyframes stroke {
            to { stroke-dashoffset: 0; }
        }

        .message {
            text-align: center;
        }
        .message .primary {
            font-size: 19px;
            font-weight: 700;
            margin: 0 0 6px;
        }
        .message .primary.standalone {
            margin: 0 0 22px;
        }
        .message .secondary {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0 0 22px;
        }
        .message .brand {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 18px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <svg class="checkmark" viewBox="0 0 52 52">
                <circle class="checkmark__circle" cx="26" cy="26" r="25" stroke-width="2"/>
                <path class="checkmark__check" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
            </svg>

            <div class="message">
                <p class="primary" id="message">Configuration successful!</p>
                <p class="secondary">设备已联网，正在启动…</p>
                <div class="brand">@WZH_EMOJI@ ZYLZ · @WZH_BRAND_NAME@</div>
            </div>
        </div>
    </div>
    
    <script>
        window.addEventListener('load', function() {
            const params = new URLSearchParams(window.location.search);
            const message = params.get('message') || 'Configuration successful!';
            const messageEl = document.getElementById('message');
            messageEl.textContent = message;
            // 中文成功文案更完整；其他语言保持原有单行样式
            if (!/[一-鿿]/.test(message)) {
                messageEl.classList.add('standalone');
                const secondary = document.querySelector('.message .secondary');
                secondary.style.display = 'none';
            }
            document.title = message;

            // Send exit request after a short delay
            setTimeout(function() {
                fetch('/exit', {
                    method: 'POST'
                })
                .then(response => {
                    if (response.ok) {
                        console.log('Exit config mode request sent');
                    } else {
                        console.error('Failed to send exit request');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
            }, 1000);
        });
    </script>
</body>
</html>
