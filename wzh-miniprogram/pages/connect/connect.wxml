<view class="connect-page">
  <view class="connect-bg" aria-hidden="true">
    <view class="blob b1"></view><view class="blob b2"></view><view class="blob b3"></view>
  </view>

  <view class="connect-top" style="padding-top: {{statusBarHeight}}px">
    <view class="brand-block">
      <image class="brand-logo" src="/assets/zeyuan-logo.png" mode="aspectFit"></image>
      <text class="brand-line">让每一个小伙伴，都有自己的声音</text>
      <view class="ble-state {{scanning ? 'on' : ''}}"><view class="ble-dot"></view><text>{{bleLabel}}</text></view>
    </view>
  </view>

  <view class="connect-hero">
    <view class="connect-title">今天想和谁玩？</view>
    <view class="connect-sub">选一款玩具，打开电源，放在手机旁边</view>
    <scroll-view class="toy-scroll" scroll-x enhanced show-scrollbar="{{false}}" enable-flex="{{true}}">
      <view wx:for="{{toys}}" wx:key="id" class="toy-card {{activeToy === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onToyFilter" aria-label="选择{{item.name}}">
        <view class="toy-card-icon"><image src="{{item.icon}}" mode="aspectFit"></image></view>
        <text class="toy-card-name">{{item.name}}</text>
        <text class="toy-card-en">{{item.code}}</text>
        <view class="toy-card-check"><view class="ico ico-check"></view></view>
      </view>
    </scroll-view>
    <view class="toy-filter-hint">{{activeToy ? '已选择 ' + activeName + '，再点一次可看全部' : '点选玩具可只看它的设备'}}</view>
  </view>

  <scroll-view class="connect-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{error}}" class="connect-error">{{error}}</view>

    <view wx:if="{{autoConnecting}}" class="last-banner auto">
      <view class="last-banner-spin"></view>
      <text class="last-banner-tx">上次连接过，正在自动连接 {{autoName}}…</text>
    </view>
    <view wx:elif="{{lastMissing && !autoConnecting}}" class="last-banner">
      <text class="last-banner-tx">上次连接的 {{lastName}} 不在附近，确认它已开机。</text>
    </view>

    <view wx:if="{{visibleDevices.length}}" class="device-group">
      <view class="device-group-head"><text>{{activeToy ? activeName : '附近的小伙伴'}}</text><text class="device-count">{{deviceCount}}</text></view>
      <view class="device-card {{item.isLast ? 'is-last' : ''}}" wx:for="{{visibleDevices}}" wx:key="deviceId" data-id="{{item.deviceId}}" bindtap="onConnect">
        <view class="device-icon"><image src="{{item.icon}}" mode="aspectFit"></image></view>
        <view class="device-copy">
          <view class="device-name-row">
            <text class="device-name">{{item.name}}</text>
            <text wx:if="{{item.isLast}}" class="device-last">上次连接</text>
          </view>
          <text class="device-meta">{{item.meta}}</text>
        </view>
        <view class="device-right">
          <view class="signal-bars" aria-hidden="true">
            <view wx:for="{{signalLevels}}" wx:for-item="bar" wx:key="*this" class="signal-bar {{bar <= item.bars ? 'on' : ''}}"></view>
          </view>
          <text class="device-rssi">{{item.rssi}} dBm</text>
        </view>
        <view class="device-go"><view class="ico ico-chev"></view></view>
      </view>
      <view class="device-tip">
        <view class="device-tip-dot"></view>
        <text>找不到？确认玩具已开机，蓝牙没有被其他手机占用，距离保持 1 米内。</text>
      </view>
    </view>

    <view wx:elif="{{!scanning}}" class="connect-empty">
      <view class="empty-orbit"><view class="ico ico-wifi"></view></view>
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="empty-sub">{{emptySub}}</text>
    </view>

    <view class="pair-guide">
      <text class="pair-guide-head">第一次连接？</text>
      <view class="pair-guide-steps">
        <view class="pair-guide-step"><text class="pair-guide-no">1</text><text class="pair-guide-tx">长按开机</text></view>
        <view class="pair-guide-step"><text class="pair-guide-no">2</text><text class="pair-guide-tx">手机靠近</text></view>
        <view class="pair-guide-step"><text class="pair-guide-no">3</text><text class="pair-guide-tx">点击连接</text></view>
      </view>
    </view>
  </scroll-view>

  <view class="connect-actions">
    <button class="scan-btn {{scanning ? 'busy' : ''}}" bindtap="onScan">
      <view wx:if="{{scanning}}" class="scan-spinner"></view>
      <view wx:else class="ico ico-reset"></view>
      <text>{{scanning ? '正在寻找…' : '重新扫描'}}</text>
    </button>
    <view class="connect-note">连接请求直接发送给玩具，无需在玩具上操作</view>
    <view class="connect-links">
      <view class="guide-link" bindtap="openGuide">第一次用？看三步引导</view>
      <view wx:if="{{isDevtools || demoAvailable}}" class="demo-link" bindtap="onDemo">没有设备？使用演示设备</view>
    </view>
  </view>

  <view wx:if="{{connecting}}" class="connecting-mask">
    <view class="connecting-card">
      <view class="connecting-spinner"></view>
      <text class="connecting-title">正在连接</text>
      <text class="connecting-name">{{connectingName}}</text>
      <text class="connecting-sub">请留意玩具屏幕上的配对提示</text>
    </view>
  </view>

  <view class="pg-root" wx:if="{{guideOpen}}">
    <view class="pg-catch" catchtap="noop" catchtouchmove="noop"></view>
    <view class="pg-spot" style="left:{{guideSpot.left}}px;top:{{guideSpot.top}}px;width:{{guideSpot.width}}px;height:{{guideSpot.height}}px;border-radius:{{guideSpot.radius}}px"></view>
    <view class="pg-bubble {{guideBubble.place}}" style="{{guideBubble.style}}">
      <view class="pg-head">
        <view class="pg-avatar"><image src="/assets/crawlPanda_icon.png" mode="aspectFit"></image></view>
        <view class="pg-meta">
          <text class="pg-kicker">ZEYUAN LINGZHI / START</text>
          <text class="pg-who">第一次连接 · 三步就好</text>
        </view>
        <text class="pg-badge">{{guideStep + 1}} / {{guideDots.length}}</text>
      </view>
      <text class="pg-title">{{guideCurrent.title}}</text>
      <text class="pg-text">{{guideCurrent.text}}</text>
      <view class="pg-foot">
        <view class="pg-dots">
          <view class="pg-dot {{index === guideStep ? 'on' : ''}}" wx:for="{{guideDots}}" wx:key="*this"></view>
        </view>
        <button class="pg-skip" bindtap="closeGuide">跳过</button>
        <button class="pg-next" bindtap="nextGuide">{{guideStep + 1 === guideDots.length ? '完成' : '下一步'}}</button>
      </view>
    </view>
  </view>
</view>
