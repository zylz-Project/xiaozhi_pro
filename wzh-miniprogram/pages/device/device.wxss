.manual-cover { display: flex; align-items: center; gap: 14rpx; padding: 18rpx; border: 1rpx solid var(--card-border); border-radius: 18rpx; background: var(--card-bg); }
.manual-cover image { width: 78rpx; height: 78rpx; object-fit: contain; }
.manual-cover .tx-b { display: block; font-size: 18rpx; }
.manual-cover .tx-small { color: var(--ink-3); font-size: 8rpx; }
