  .orb-bubbles .tx-i:nth-child(10) { --bx: 24%; --by: 88%; --bs: 19.23rpx; --rise: 88.46rpx; --dx: -9.62rpx; --rot: -12deg; --dur: 4.9s; --morph: 4.2s; --delay: -3.9s; --bo: .56; }

  /* Foam escaping the orb silhouette: bigger, slower bubbles that make speech feel alive. */
  .orb-foam {
    position: absolute;
    z-index: 3;
    width: 565.38rpx;
    height: 565.38rpx;
    pointer-events: none;
    overflow: visible;
  }
  .orb-foam .tx-i {
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 84%);
    width: var(--fs, 46.15rpx);
    height: var(--fs, 46.15rpx);
    border: 1.92rpx solid rgba(255,255,255,.82);
    border-radius: 50% 46% 54% 48% / 46% 52% 48% 54%;
    background:
      radial-gradient(circle at 30% 24%, rgba(255,255,255,.98) 0 6%, rgba(255,255,255,.42) 19%, rgba(255,232,212,.22) 45%, rgba(255,255,255,.02) 76%),
      linear-gradient(145deg, rgba(255,205,170,.24), rgba(255,255,255,.02));
    box-shadow:
      inset 3.85rpx 5.77rpx 15.38rpx rgba(255,255,255,.92),
      inset -11.54rpx -13.46rpx 26.92rpx rgba(188,104,66,.18),
      0 0 0 1.92rpx rgba(255,255,255,.16),
      0 19.23rpx 42.31rpx -19.23rpx rgba(150,78,42,.26);
    opacity: 0;
    transform: translate3d(0, 30.77rpx, 0) scale(.66) rotate(-4deg);
    -webkit-backdrop-filter: blur(2.31rpx) saturate(140%);
    backdrop-filter: blur(2.31rpx) saturate(140%);
    will-change: transform, border-radius;
  }
  .orb-foam .tx-i::after {
    content: "";
    position: absolute;
    left: 18%;
    top: 13%;
    width: 28%;
    height: 19%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,.98), rgba(255,255,255,0) 72%);
    transform: rotate(-28deg);
  }
  .orb-foam .tx-i:nth-child(1) { --fx: 4%; --fy: 80%; --fs: 73.08rpx; --fdx: -30.77rpx; --fdy: -200rpx; --frot: 9deg; --fdur: 7.1s; --fdelay: -1.2s; --fo: .54; }
  .orb-foam .tx-i:nth-child(2) { --fx: 76%; --fy: 84%; --fs: 84.62rpx; --fdx: 38.46rpx; --fdy: -223.08rpx; --frot: -10deg; --fdur: 7.6s; --fdelay: -4.4s; --fo: .5; background: radial-gradient(circle at 30% 24%, rgba(255,255,255,.98) 0 6%, rgba(255,255,255,.42) 18%, rgba(226,240,226,.22) 44%, rgba(255,255,255,.02) 76%), linear-gradient(145deg, rgba(194,220,196,.22), rgba(255,255,255,.02)); }
  .orb-foam .tx-i:nth-child(3) { --fx: 47%; --fy: 94%; --fs: 53.85rpx; --fdx: -13.46rpx; --fdy: -246.15rpx; --frot: 12deg; --fdur: 6.1s; --fdelay: -2.6s; --fo: .58; }
  .orb-foam .tx-i:nth-child(4) { --fx: 20%; --fy: 96%; --fs: 34.62rpx; --fdx: 13.46rpx; --fdy: -176.92rpx; --frot: -9deg; --fdur: 5.4s; --fdelay: -.7s; --fo: .48; }
  .orb-foam .tx-i:nth-child(5) { --fx: 64%; --fy: 97%; --fs: 40.38rpx; --fdx: 5.77rpx; --fdy: -188.46rpx; --frot: 7deg; --fdur: 5.8s; --fdelay: -3.4s; --fo: .52; }
  .orb-foam .tx-i:nth-child(6) { --fx: 86%; --fy: 68%; --fs: 42.31rpx; --fdx: 26.92rpx; --fdy: -165.38rpx; --frot: -12deg; --fdur: 6.6s; --fdelay: -2.1s; --fo: .44; }
  .orb-foam .tx-i:nth-child(7) { --fx: 0%; --fy: 62%; --fs: 30.77rpx; --fdx: -17.31rpx; --fdy: -146.15rpx; --frot: 10deg; --fdur: 5.0s; --fdelay: -1.5s; --fo: .4; }
  .orb-foam .tx-i:nth-child(8) { --fx: 54%; --fy: 86%; --fs: 23.08rpx; --fdx: -3.85rpx; --fdy: -150rpx; --frot: -7deg; --fdur: 4.7s; --fdelay: -.9s; --fo: .5; }
  .orb-foam .tx-i:nth-child(9) { --fx: 12%; --fy: 58%; --fs: 61.54rpx; --fdx: 15.38rpx; --fdy: -126.92rpx; --frot: 8deg; --fdur: 8.0s; --fdelay: -5.9s; --fo: .36; background: radial-gradient(circle at 30% 24%, rgba(255,255,255,.98) 0 6%, rgba(255,255,255,.4) 19%, rgba(243,225,244,.22) 44%, rgba(255,255,255,.02) 76%), linear-gradient(145deg, rgba(226,202,226,.20), rgba(255,255,255,.02)); }
  .orb-foam .tx-i:nth-child(10) { --fx: 72%; --fy: 58%; --fs: 69.23rpx; --fdx: -17.31rpx; --fdy: -138.46rpx; --frot: -6deg; --fdur: 8.4s; --fdelay: -7.1s; --fo: .34; }

  .phone[data-state="speaking"] .orb-bubbles .tx-i {
    opacity: var(--bo, .6);
    animation:
      bubbleDrift var(--dur, 5s) cubic-bezier(.38,.05,.3,1) infinite,
      bubbleMorph var(--morph, 5s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .phone[data-state="speaking"] .orb-foam .tx-i {
    animation:
      foamRise var(--fdur, 6s) cubic-bezier(.25,.55,.3,1) infinite,
      bubbleMorph var(--fdur, 6s) ease-in-out infinite;
    animation-delay: var(--fdelay, 0s);
  }
  .phone[data-state="speaking"] .orb-voice { animation: voiceAura 1.7s ease-in-out infinite; }
  .panda {
    position: relative;
    z-index: 2;
    width: 317.31rpx;
    height: 317.31rpx;
    margin-top: 34.62rpx;
    filter: drop-shadow(0 34.62rpx 34.62rpx rgba(83,47,21,.18));
    animation: breathe 4.8s ease-in-out infinite;
    transform-origin: 50% 82%;
  }
  .panda image { width: 100%; height: 100%; object-fit: contain; }
  .contact-shadow {
    position: absolute;
    bottom: 26.92rpx;
    width: 219.23rpx;
    height: 28.85rpx;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(81,46,22,.24), rgba(81,46,22,0) 72%);
    filter: blur(17.31rpx);
    opacity: .8;
    pointer-events: none;
  }

  .phone[data-state="listening"] .panda { animation-duration: 2.5s; }
  .phone[data-state="speaking"] .panda { animation: pandaTalk 2.2s cubic-bezier(.42,0,.2,1) infinite; filter: drop-shadow(0 34.62rpx 34.62rpx rgba(83,47,21,.18)) drop-shadow(0 0 38.46rpx rgba(255,166,115,.28)); }
  .phone[data-state="connecting"] .orb-glow { opacity: .4; }
  .phone[data-state="connecting"] .orb { animation: orbWait 3s ease-in-out infinite; }
  .phone[data-state="listening"] .orb { animation: orbListen 2.2s ease-in-out infinite; }
  .phone[data-state="speaking"] .orb { animation: orbJelly 3.4s ease-in-out infinite; }
  .phone[data-state="offline"] .orb { filter: saturate(.42) brightness(.94); }
  .phone[data-state="offline"] .panda { filter: grayscale(.82) opacity(.66) drop-shadow(0 26.92rpx 26.92rpx rgba(83,47,21,.12)); animation: none; }
  .phone[data-state="offline"] .orb-glow { opacity: .25; }

  /* Sheet */
  .sheet {
    position: absolute;
    z-index: 7;
    left: 23.08rpx;
    right: 23.08rpx;
    top: 946.15rpx;
    bottom: 23.08rpx;
    overflow: hidden;
    border-radius: 65.38rpx;
    background: var(--glass-bg);
    border: 1.92rpx solid var(--glass-border);
    box-shadow:
      0 65.38rpx 126.92rpx -65.38rpx rgba(76,46,22,.42),
      0 1.92rpx 0 rgba(255,255,255,.72) inset,
      0 -1.92rpx 0 rgba(255,255,255,.22) inset;
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(182%);
    backdrop-filter: blur(var(--glass-blur)) saturate(182%);
    transition:
      top .56s cubic-bezier(.2,.82,.2,1),
      border-radius .45s ease,
      background .45s ease;
  }
  .sheet:before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(118deg, rgba(255,255,255,.48) 0%, rgba(255,255,255,.10) 23%, rgba(255,255,255,0) 44%, rgba(255,255,255,.13) 100%);
  }
  .sheet:after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1.92rpx 0 rgba(255,255,255,.68);
  }

  .handle {
    position: relative;
    z-index: 3;
    display: block;
    width: 100%;
    height: 84.62rpx;
    padding: 34.62rpx 0 0;
    border: 0;
    background: transparent;
    cursor: grab;
  }
  .handle:active { cursor: grabbing; }
  .handle .tx-span {
    display: block;
    width: 73.08rpx;
    height: 7.69rpx;
    margin: 0 auto;
    border-radius: 190.38rpx;
    background: rgba(47,40,34,.20);
    box-shadow: 0 1.92rpx 0 rgba(255,255,255,.58);
    transition: width .2s ease, background .2s ease;
  }
  .handle:hover .tx-span { width: 84.62rpx; background: rgba(47,40,34,.27); }

  .sheet-main {
    position: relative;
    z-index: 2;
    padding: 0 26.92rpx 26.92rpx;
    transition: opacity .20s ease;
  }
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42.31rpx;
  }
  .sheet-head .tx-h2 {
    margin: 0;
    font-size: 29.81rpx;
    line-height: 1;
    font-weight: 650;
    letter-spacing: -.025em;
  }
  .sheet-state {
    display: inline-flex;
    align-items: center;
    gap: 9.62rpx;
    font-size: 21.15rpx;
    line-height: 1;
    font-weight: 550;
    color: var(--ink-2);
  }
  .sheet-state:before {
    content: "";
    width: 7.69rpx;
    height: 7.69rpx;
    border-radius: 50%;
    background: currentColor;
    opacity: .55;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13.46rpx;
    margin-top: 19.23rpx;
  }
  .metric {
    min-width: 0;
    padding: 19.23rpx 19.23rpx 17.31rpx;
    border-radius: 32.69rpx;
    background: var(--card-bg);
    border: 1.92rpx solid var(--card-border);
    box-shadow: inset 0 1.92rpx 0 rgba(255,255,255,.35);
  }
  .metric .tx-small {
    display: block;
    font-size: 21.15rpx;
    line-height: 1;
    font-weight: 550;
    letter-spacing: .03em;
    color: var(--ink-2);
  }
  .metric .tx-b {
    display: block;
    margin-top: 15.38rpx;
    overflow: hidden;
    color: var(--ink);
    font-size: 40.38rpx;
    line-height: 1;
    font-weight: 650;
    letter-spacing: -.045em;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .metric .tx-b .tx-span {
    margin-left: 1.92rpx;
    font-size: 21.15rpx;
    font-weight: 600;
    letter-spacing: -.01em;
    opacity: .70;
  }
  .metric .tx-b.ssid { font-size: 32.69rpx; letter-spacing: -.035em; }
  .metric .tx-em {
    display: block;
    margin-top: 9.62rpx;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 20.19rpx;
    line-height: 1;
    font-style: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .volume-row {
    display: flex;
    align-items: center;
    gap: 19.23rpx;
    height: 84.62rpx;
    margin-top: 17.31rpx;
  }
  .row-label {
    flex: 0 0 auto;
    font-size: 22.12rpx;
    font-weight: 550;
    color: var(--ink-2);
  }
  .volume {
    --val: 60%;
    width: 100%;
    height: 84.62rpx;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: pointer;
  }
  .volume:focus-visible { outline: 3.85rpx solid rgba(201,119,82,.68); outline-offset: 5.77rpx; border-radius: 15.38rpx; }
  .volume::-webkit-slider-runnable-track {
    height: 11.54rpx;
    border-radius: 190.38rpx;
    background: linear-gradient(to right, var(--accent) 0%, var(--accent) var(--val), rgba(47,40,34,.13) var(--val), rgba(47,40,34,.13) 100%);
    box-shadow: inset 0 1.92rpx 1.92rpx rgba(47,40,34,.10);
  }
  .volume::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 34.62rpx;
    height: 34.62rpx;
    margin-top: -11.54rpx;
    border: 3.85rpx solid rgba(255,255,255,.94);
    border-radius: 50%;
    background: #fffaf2;
    box-shadow: 0 3.85rpx 13.46rpx rgba(70,42,23,.24), 0 0 0 1.92rpx rgba(47,40,34,.05);
  }
  .volume::-moz-range-track {
    height: 11.54rpx;
    border-radius: 190.38rpx;
    background: rgba(47,40,34,.13);
  }
  .volume::-moz-range-progress {
    height: 11.54rpx;
    border-radius: 190.38rpx;
    background: var(--accent);
  }
  .volume::-moz-range-thumb {
    width: 30.77rpx;
    height: 30.77rpx;
    border: 3.85rpx solid rgba(255,255,255,.94);
    border-radius: 50%;
    background: #fffaf2;
    box-shadow: 0 3.85rpx 13.46rpx rgba(70,42,23,.24);
  }
  .volume-val {
    flex: 0 0 50rpx;
    text-align: right;
    color: var(--ink-2);
    font-size: 22.12rpx;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .voice-row {
    display: flex;
    align-items: center;
    gap: 17.31rpx;
    width: 100%;
    min-height: 88.46rpx;
    margin-top: 9.62rpx;
    padding: 0 21.15rpx;
    border-radius: 30.77rpx;
    border: 1.92rpx solid var(--card-border);
    background: var(--card-bg);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    box-shadow: inset 0 1.92rpx 0 rgba(255,255,255,.30);
    transition: transform .15s ease, background .15s ease;
  }
  .voice-row:active { transform: scale(.992); }
  .voice-ico {
    display: grid;
    place-items: center;
    flex: 0 0 51.92rpx;
    width: 51.92rpx;
    height: 51.92rpx;
    border-radius: 17.31rpx;
    background: rgba(255,255,255,.40);
    color: var(--accent-deep);
  }
  .voice-meta { min-width: 0; }
  .voice-meta .tx-span {
    display: block;
    font-size: 20.19rpx;
    line-height: 1;
    color: var(--ink-2);
  }
  .voice-meta .tx-b {
    display: block;
    margin-top: 7.69rpx;
    overflow: hidden;
    font-size: 25rpx;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .voice-try {
    margin-left: auto;
    padding: 9.62rpx 15.38rpx;
    border-radius: 190.38rpx;
    background: rgba(255,255,255,.40);
    color: var(--accent-deep);
    font-size: 20.19rpx;
    line-height: 1;
    font-weight: 600;
  }
  .chev { width: 26.92rpx; height: 26.92rpx; flex: 0 0 26.92rpx; color: var(--ink-3); }

  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15.38rpx;
    width: 100%;
    height: 100rpx;
    margin-top: 19.23rpx;
    border: 0;
    border-radius: 34.62rpx;
    color: #fff9f0;
    background: #302720;
    box-shadow: 0 30.77rpx 46.15rpx -28.85rpx rgba(43,29,18,.72), inset 0 1.92rpx 0 rgba(255,255,255,.14);
    font-size: 25rpx;
    font-weight: 600;
    letter-spacing: .01em;
    cursor: pointer;
    transition: transform .16s ease, background .18s ease, opacity .18s ease;
  }
  .primary:hover { background: #261f19; }
  .primary:active { transform: translateY(1.92rpx) scale(.996); }
  .primary:disabled {
    cursor: default;
    color: rgba(255,250,242,.58);
    background: rgba(48,39,32,.52);
    box-shadow: inset 0 1.92rpx 0 rgba(255,255,255,.08);
  }
  .primary .ico { width: 32.69rpx; height: 32.69rpx; }
  .primary:focus-visible, .voice-row:focus-visible, .handle:focus-visible, .statebar button:focus-visible, .close-more:focus-visible, .row:focus-visible {
    outline: 3.85rpx solid rgba(255,255,255,.88);
    outline-offset: 5.77rpx;
  }

  /* Expanded sheet */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: rgba(48,31,18,.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity .4s ease;
    -webkit-backdrop-filter: blur(2.88rpx);
    backdrop-filter: blur(2.88rpx);
  }
  .phone.expanded .scrim { opacity: 1; pointer-events: auto; }
  .phone.expanded .sheet { top: 107.69rpx; border-radius: 65.38rpx; }
  .phone.expanded .brand { opacity: 0; filter: blur(7.69rpx); }
  .phone.expanded .statusbar { opacity: .20; filter: blur(2.88rpx); }
  .phone.expanded .orb-wrap { opacity: .18; filter: blur(5.77rpx); }
  .phone.expanded .orb-wrap { transform: scale(.96); }
  .phone.expanded .orb-wrap .orb { box-shadow: 0 34.62rpx 115.38rpx rgba(54,36,22,.10); }
  .phone.expanded .sheet-main { opacity: 0; visibility: hidden; pointer-events: none; }
  .phone.expanded .handle { opacity: 0; visibility: hidden; pointer-events: none; }
  .phone.expanded .sheet-more {
    display: block;
    top: 0;
    padding-top: 0;
    animation: sheetIn .34s cubic-bezier(.2,.8,.2,1) both;
  }
  .phone.expanded .sheet-more.console {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .sheet-more {
    display: none;
    position: absolute;
    z-index: 4;
    top: 84.62rpx;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 30.77rpx 30.77rpx;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .sheet-more::-webkit-scrollbar { display: none; }
  .console-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: 0 30.77rpx 16rpx;
  }
  .console-scroll::-webkit-scrollbar { display: none; }
  .more-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26.92rpx;
    padding: 5.77rpx 0 23.08rpx;
  }
  .more-eyebrow {
    font-size: 19.23rpx;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .10em;
    color: var(--ink-3);
  }
  .more-head {
    margin-top: 7.69rpx;
    font-size: 34.62rpx;
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -.03em;
  }
  .more-state {
    margin-top: 7.69rpx;
    font-size: 21.15rpx;
    line-height: 1;
    color: var(--ink-2);
  }
  .close-more {
    display: grid;
    place-items: center;
    flex: 0 0 84.62rpx;
    width: 84.62rpx;
    height: 84.62rpx;
    border: 1.92rpx solid var(--card-border);
    border-radius: 50%;
    color: var(--ink-2);
    background: var(--card-bg);
    cursor: pointer;
    transition: transform .15s ease, background .15s ease;
