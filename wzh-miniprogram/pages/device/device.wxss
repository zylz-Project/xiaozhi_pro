.manual-chapter .tx-p { margin: 0 0 5rpx; color: var(--ink-2); font-size: 9rpx; line-height: 1.65; }
.manual-chapter .manual-ul { margin: 0; padding-left: 14rpx; }
.manual-chapter .manual-li { color: var(--ink-2); font-size: 9rpx; line-height: 1.65; }

/* ---------- mini program refinements: battery, rails, modals, wifi, manual ---------- */
/* Battery: the web page draws a 4.6px SVG ring (index.html .battery-ring), not
   a filled pie. Paint the arc on ::after and mask out the centre so the dial
   reads as a ring while .battery-core / .battery-bolt stay on top. */
.battery-dial { background: transparent; }
.battery-dial::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(var(--accent) calc(var(--level, 86) * 1%), rgba(47, 40, 34, .12) 0);
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4.6px), #000 calc(100% - 4.6px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 4.6px), #000 calc(100% - 4.6px));
}
.phone.dark .battery-dial::after {
  background: conic-gradient(var(--accent) calc(var(--level, 86) * 1%), rgba(255, 255, 255, .14) 0);
}
.battery-dial::before { background: var(--dial-core); }
.theme-now { flex: 0 0 auto; }

/* fixed rail drift is driven from device.js via scroll-left (drag + auto-drift). */

.con-head-main { flex: 1; min-width: 0; }
