/* ---------- mini program shell: avoid WeChat capsule + real status bar ---------- */
/* The web prototype drew a fake phone clock; on a real phone the system status
   bar already shows it, and the capsule sits at the top right. Keep only the
   online chip on the left, below the system status bar. */
.statusbar { justify-content: flex-start; height: 56rpx; }
.phone.expanded .brand,
.phone.expanded .statusbar { opacity: 0; visibility: hidden; filter: none; }

/* The wordmark is swapped to a white asset on dark themes because CSS filters
   do not reliably apply to the native <image> component in WeChat. */
.phone.dark .brand-mark { filter: none; opacity: 1; }
.brand .tx-b { font-size: 30rpx; }
.brand .tx-span { margin-top: 3rpx; font-size: 14rpx; letter-spacing: .06em; }

/* Start the console below the capsule, not at a fixed offset from the status bar. */
.phone.expanded .sheet { top: calc(var(--menu-bottom, 86px) + 8px); }
.console .con-head { padding-top: 24rpx; }

/* Home indicator must not cover the voice-manager primary action. */
.modal-foot { padding-bottom: calc(25rpx + env(safe-area-inset-bottom)); }

/* The toy switcher lives behind the wordmark; make the affordance visible. */
.brand-chev { width: 22rpx; height: 22rpx; opacity: .55; }

/* Dark status chip: the prototype's dark-brown text is unreadable on the
   translucent dark bar. Use warm white and a brighter green dot. */
.phone.dark .status-pill {
  color: #f8efe5;
  border-color: rgba(255,255,255,.30);
  background: rgba(255,255,255,.14);
  box-shadow: 0 9.62rpx 26.92rpx -19.23rpx rgba(0,0,0,.40), inset 0 1.92rpx 0 rgba(255,255,255,.12);
}
.phone.dark .status-pill .status-dot {
  background: #7fd6a4;
  box-shadow: 0 0 0 5.77rpx rgba(127,214,164,.16);
}
.phone.dark .status-pill.is-offline { color: rgba(246,236,226,.55); }

/* Full-screen manual, matching the web overlay instead of an inset sheet. */
.manual-sheet {
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}
.manual-close-float {
  top: calc(var(--safe-top, 34.62rpx) + 8px);
  left: 20rpx;
  right: auto;
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx;
  background: rgba(255,255,255,.72);
}
.manual-body {
  padding: calc(var(--safe-top, 34.62rpx) + 52px) 26.92rpx calc(24rpx + env(safe-area-inset-bottom));
}
.manual-page {
  padding-top: 0;
  color: var(--ink);
  font-size: inherit;
  line-height: normal;
  font-weight: 400;
  letter-spacing: normal;
}
.phone.dark .reset-bar {
  color: #f0b49c;
  border-color: rgba(240,180,156,.30);
  background: rgba(240,180,156,.09);
}
.phone.dark .reset-bar .reset-ico { background: rgba(240,180,156,.14); }
.phone.dark .reset-bar .reset-copy .tx-small { color: rgba(240,180,156,.78); }


/* ---------- first-run guide: spotlight + bubble ---------- */
.con-guide { position: relative; }
.con-guide-q {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  text-align: center;
  border-radius: 50%;
  background: #2b241e;
  color: #fff8ef;
