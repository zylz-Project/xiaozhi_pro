}

/* WeChat gives <button> a 184px default width; restore explicit sizing. */
.primary, .reset-bar, .vm-new { width: 100% !important; }
.voice-try, .voice-add, .vm-hero-play, .wifi-rescan, .pg-skip, .pg-next { width: auto !important; }
.manual-close-float { width: 76rpx !important; height: 76rpx !important; }


/* ---------- readability pass: theme rows, manual, modal actions ---------- */
/* Theme "布局 / 玻璃" must stay on ONE row, exactly like the web detail page
   (index.css .theme-pair + .theme-mini). The earlier two-row override made the
   panel taller than the reference, so it is reverted to the web proportions:
   pair 36px tall, key 24px, buttons 36px with 9.5px labels, 15px previews. */
.theme-pair { flex-direction: row; align-items: stretch; gap: 13.46rpx; margin-top: 3.85rpx; }
.theme-mini { flex: 1 1 0; width: auto; gap: 7.69rpx; }
.theme-mini .theme-key { flex: 0 0 46.15rpx; font-size: 18.27rpx; }
.theme-mini .layout-btn,
.theme-mini .mat-btn { height: 67.16rpx; padding: 0 5.77rpx; gap: 5.77rpx; font-size: 18.27rpx; }
.theme-mini .layout-btn .tx-b,
.theme-mini .mat-btn .tx-b { font-size: 16.35rpx; }
.theme-mini .mat-prev,
.theme-mini .layout-prev { flex-basis: 27.99rpx; width: 27.99rpx; height: 27.99rpx; }
.theme-mini .layout-prev.continuous::before {
  top: 7.69rpx; right: 5.77rpx; left: 5.77rpx;
  box-shadow: 0 5.77rpx 0 var(--accent), 0 11.54rpx 0 var(--accent);
}
.theme-mini .layout-prev.cards::before {
  top: 5.77rpx; left: 5.77rpx; width: 5.77rpx; height: 5.77rpx;
  box-shadow: 9.62rpx 0 0 var(--accent), 0 9.62rpx 0 var(--accent), 9.62rpx 9.62rpx 0 var(--accent);
}
.theme-line { margin-top: 7.69rpx; }

/* Manual: pull the cover closer to the floating close button and raise body
   text from 10.8px to ~11.9px, which is still compact but readable on phones. */
.manual-body { padding-top: calc(var(--safe-top, 34.62rpx) + 40px); }
.manual-cover .tx-b { font-size: 28.85rpx; }
.manual-cover .tx-small { font-size: 19.23rpx; }
.manual-chapter .ch-no { font-size: 18.27rpx; }
.manual-chapter .tx-h3 { font-size: 30.77rpx; }
.manual-chapter .tx-p { font-size: 22.12rpx; line-height: 1.72; }
.manual-chapter .manual-li { font-size: 22.12rpx; line-height: 1.72; }

/* Danger strip and key controls: one step up from the web micro-type. */
.reset-copy .tx-small { font-size: 21.15rpx; color: rgba(127,50,37,.92); }
.phone.dark .reset-bar .reset-copy .tx-small { color: rgba(240,180,156,.90); }
.con-volume .row-label { font-size: 20.19rpx; }
.create-tab { height: 69.23rpx; font-size: 20rpx; }
.modal-btn { height: 84.62rpx; font-size: 22.12rpx; }
.vm-new { height: 80.77rpx; font-size: 21.15rpx; }

/* Bottom sheets must clear the iPhone home indicator. */
.panda-modal { padding-bottom: calc(19.23rpx + env(safe-area-inset-bottom)); }

/* Selected theme buttons must not become a pale block under white text in dark
   mode, and the A/B previews must read as glass vs. milk rather than checkboxes. */
.phone.dark .layout-btn.is-on.is-on,
.phone.dark .mat-btn.is-on.is-on,
.phone.dark .layout-btn[aria-pressed="true"],
.phone.dark .mat-btn[aria-pressed="true"] {
  color: var(--ink);
  border-color: var(--accent);
  background: rgba(255,255,255,.15);
