  /* Draggable assistant bubble — only while the console is open. */
  .float-assistant {
    display: none;
    position: absolute;
    z-index: 11;
    right: 26.92rpx;
    bottom: 26.92rpx;
    width: 100rpx;
    height: 100rpx;
    padding: 0;
    place-items: center;
    border: 1.92rpx solid rgba(255,255,255,.76);
    border-radius: 50%;
    color: #3b2a20;
    background:
      radial-gradient(circle at 31% 22%, #fff9ef 0%, #ffe4cf 40%, #f7bc9c 76%, #efa27f 100%);
    box-shadow:
      0 38.46rpx 65.38rpx -34.62rpx rgba(96,45,23,.68),
      0 3.85rpx 0 rgba(255,255,255,.85) inset,
      0 -23.08rpx 38.46rpx rgba(213,112,73,.18) inset;
    cursor: grab;
    touch-action: none;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .phone.expanded .float-assistant { display: grid; animation: assistantIn .38s cubic-bezier(.2,.85,.2,1) both; }
  .phone.manual-open .float-assistant { display: none; }
  .float-assistant:hover { transform: translateY(-1.92rpx) scale(1.025); }
  .float-assistant:active, .float-assistant.dragging { cursor: grabbing; transform: scale(1.05); box-shadow: 0 46.15rpx 76.92rpx -34.62rpx rgba(96,45,23,.74), 0 3.85rpx 0 rgba(255,255,255,.9) inset; }
  .float-assistant:focus-visible { outline: 3.85rpx solid rgba(255,255,255,.9); outline-offset: 5.77rpx; }
  .fa-pulse { position: absolute; inset: -13.46rpx; border: 1.92rpx solid rgba(238,145,99,.48); border-radius: 50%; opacity: 0; pointer-events: none; }
  .float-assistant .fa-face { display: grid; place-items: center; width: 61.54rpx; height: 61.54rpx; color: #3a2a21; filter: drop-shadow(0 3.85rpx 5.77rpx rgba(109,52,28,.14)); }
  .float-assistant .fa-face .ico, .float-assistant .fa-face image { display: block; width: 61.54rpx; height: 61.54rpx; object-fit: contain; }
  .float-assistant .fa-mic { position: absolute; right: -1.92rpx; bottom: -1.92rpx; display: grid; place-items: center; width: 42.31rpx; height: 42.31rpx; border: 3.85rpx solid #ffe0ca; border-radius: 50%; color: #fff7eb; background: #3a2a21; box-shadow: 0 7.69rpx 15.38rpx -7.69rpx rgba(58,42,33,.55); }
  .float-assistant .fa-mic .ico { width: 23.08rpx; height: 23.08rpx; }
  .float-assistant .fa-label {
    position: absolute;
    left: 50%;
    bottom: -32.69rpx;
    transform: translateX(-50%);
    padding: 3.85rpx 11.54rpx;
    border: 1.92rpx solid rgba(255,255,255,.68);
    border-radius: 11.54rpx;
    color: #5b3b2b;
    background: rgba(255,246,236,.82);
    font-size: 15.38rpx;
    line-height: 1;
    letter-spacing: .04em;
    white-space: nowrap;
    pointer-events: none;
  }
  .phone[data-state="speaking"] .float-assistant .fa-pulse { animation: faPulse 1.75s cubic-bezier(.16,.7,.24,1) infinite; }
  .phone[data-state="listening"] .float-assistant .fa-pulse { animation: faPulse 2.5s cubic-bezier(.16,.7,.24,1) infinite; border-color: rgba(100,160,120,.42); }
  @keyframes assistantIn { from { opacity: 0; transform: translateY(15.38rpx) scale(.9); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes faPulse { 0% { opacity: .62; transform: scale(.92); } 70%, 100% { opacity: 0; transform: scale(1.36); } }

