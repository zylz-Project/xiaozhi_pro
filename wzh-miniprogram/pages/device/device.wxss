}
.phone.dark .layout-btn.is-on .tx-b,
.phone.dark .mat-btn.is-on .tx-b { color: var(--ink-2); }
.mat-prev.a {
  background: linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,.46));
  border-color: rgba(47,40,34,.22);
  box-shadow: inset 0 1.92rpx 0 rgba(255,255,255,.65);
}
