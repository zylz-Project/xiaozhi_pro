/* The dark theme only overrides --ink/--ink-2/--ink-3; the manual body uses
   --ink-soft for paragraphs, so scope a light value to the manual sheet. */
.phone.dark .manual-sheet { --ink-soft: rgba(246,236,226,.72); }

/* guide: hide bubble while console/manual state changes, then swap in one frame */
.pg-root.hide-bubble .pg-bubble {
  opacity: 0 !important;
  transition: none !important;
}
.pg-root.hide-bubble .pg-spot {
  border-color: transparent !important;
}

/* ============================================================
   Real-device performance pass (orb) + 新建 chip centering
   Android WebView was re-rasterising the whole orb on every frame:
   a 266px circle with backdrop-filter, 20 bubbles that also each had
   backdrop-filter, an animated border-radius, and runtime blur filters
   on aurora/glow/voice. Softness is baked into gradients instead and
   motion is transform/opacity only.
   ============================================================ */

/* 1. no backdrop blur inside the orb */
.orb,
.phone.a .orb,
.phone.b .orb,
.phone[data-state="speaking"] .orb,
.orb-bubbles .tx-i,
.orb-foam .tx-i {
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

/* 2. no runtime blur filters in the orb area */
.orb-glow,
.orb-aurora,
.orb-voice,
.orb:before,
.phone[data-state="speaking"] .orb-aurora,
.phone[data-state="speaking"] .orb-glow,
.orb-bubbles .tx-i::after,
.orb-foam .tx-i::after,
.phone.expanded .orb-wrap,
.phone.manual-open .sheet {
  filter: none !important;
}

/* 3. aurora / glow without blur: softness baked into radial gradients */
.orb-aurora {
  background:
    radial-gradient(circle at 32% 36%, rgba(255,173,128,.30), rgba(255,173,128,0) 58%),
    radial-gradient(circle at 68% 62%, rgba(174,205,177,.26), rgba(174,205,177,0) 56%),
    radial-gradient(circle at 50% 50%, rgba(255,215,178,.16), rgba(255,215,178,0) 66%);
}
.orb-glow {
  background: radial-gradient(circle, rgba(255,232,210,.74), rgba(255,232,210,0) 68%);
}

/* 4. jelly via transform (animating border-radius repaints the whole orb) */
.phone[data-state="speaking"] .orb {
  animation: orbJellyT 3.4s ease-in-out infinite;
}
@keyframes orbJellyT {
  0%, 100% { transform: scale(1, 1); }
  24% { transform: scale(1.014, .988); }
  50% { transform: scale(.992, 1.010); }
  76% { transform: scale(1.008, .994); }
}

/* 5. bubbles drift only; drop the per-frame border-radius morph */
.phone[data-state="speaking"] .orb-bubbles .tx-i {
  animation: bubbleDrift var(--dur, 5s) cubic-bezier(.38,.05,.3,1) infinite;
  animation-delay: var(--delay, 0s);
}
.phone[data-state="speaking"] .orb-foam .tx-i {
  animation: foamRise var(--fdur, 6s) cubic-bezier(.25,.55,.3,1) infinite;
  animation-delay: var(--fdelay, 0s);
}

/* 6. promote animated layers once; stop transitioning filter */
.orb,
.orb-aurora,
.orb-glow,
.orb-voice,
.orb-bubbles,
.orb-foam,
.panda { will-change: transform, opacity; }
.orb-bubbles .tx-i,
.orb-foam .tx-i { will-change: transform, opacity; }
.orb-wrap { transition: opacity .45s ease, transform .45s cubic-bezier(.2,.8,.2,1); }

/* 7. 新建 chip: content was top-aligned inside the 32px pill */
.clone-rail .voice-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7.69rpx;
  line-height: 1;
}

/* 8. the orb sits behind the console / manual at low opacity: stop its
      animations there instead of animating 20 invisible layers.
      (WXSS rejects the universal selector, so the layers are listed.) */
.phone.expanded .orb,
.phone.expanded .orb-glow,
.phone.expanded .orb-aurora,
.phone.expanded .orb-voice,
.phone.expanded .orb-ripples .tx-i,
.phone.expanded .orb-bubbles .tx-i,
.phone.expanded .orb-foam .tx-i,
.phone.expanded .panda,
.phone.manual-open .orb,
.phone.manual-open .orb-glow,
.phone.manual-open .orb-aurora,
.phone.manual-open .orb-voice,
.phone.manual-open .orb-ripples .tx-i,
.phone.manual-open .orb-bubbles .tx-i,
.phone.manual-open .orb-foam .tx-i,
.phone.manual-open .panda {
  animation-play-state: paused !important;
}


/* ---------- live orb: speed follows the device's real state + volume ---------- */
/* --orb-k is set inline on .orb-wrap from the status frame (idle 1.15 → loud
   speaking 0.55). Only animation-duration/opacity change, so nothing reflows. */
.orb-wrap .orb-bubbles .tx-i,
.phone[data-state="speaking"] .orb-bubbles .tx-i {
  animation-duration: calc(var(--dur, 6s) * var(--orb-k, 1)) !important;
}
.orb-wrap .orb-foam .tx-i,
.phone[data-state="speaking"] .orb-foam .tx-i {
  animation-duration: calc(var(--fdur, 6s) * var(--orb-k, 1)) !important;
}
.phone[data-state="speaking"] .orb-bubbles .tx-i {
  opacity: calc(var(--bo, .6) * (.85 + var(--orb-e, .55) * .3)) !important;
}
.phone[data-state="speaking"] .orb { animation-duration: calc(3.4s * var(--orb-k, 1)) !important; }
.phone[data-state="speaking"] .panda { animation-duration: calc(2.2s * var(--orb-k, 1)) !important; }
.phone[data-state="speaking"] .orb-glow { animation-duration: calc(1.55s * var(--orb-k, 1)) !important; }
.phone[data-state="speaking"] .orb-voice { animation-duration: calc(1.7s * var(--orb-k, 1)) !important; }

/* 温度分级（固件只给“正常/偏高”，这里按 45/55℃ 细分并上色） */
.tx-em.temp-warm { color: #b0672a; }
.tx-em.temp-hot { color: #b23c2c; }
.phone.dark .tx-em.temp-warm { color: #e2a76a; }
.phone.dark .tx-em.temp-hot { color: #f0a08c; }



/* 滚到控制台底部时淡出小助手，避免遮住“恢复出厂”条 */
.float-assistant { transition: opacity .22s ease; }
.float-assistant.dim { opacity: 0 !important; pointer-events: none; }

