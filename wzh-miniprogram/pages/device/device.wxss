/* ---------- safe-area alignment for real phones ---------- */
/* The web prototype assumed a 390x844 artboard with a 18px status bar.
   On a phone the status bar is taller; anchor brand/orb/expanded sheet to it. */
.brand { top: calc(var(--safe-top, 34.62rpx) + 34px); }
.orb-wrap { top: calc(var(--safe-top, 34.62rpx) + 78px); }
.phone.expanded .sheet { top: calc(var(--safe-top, 34.62rpx) + 38px); }
.manual-sheet { top: calc(var(--safe-top, 34.62rpx) + 38px); }
.sheet { bottom: calc(12px + env(safe-area-inset-bottom)); }
.manual-sheet { bottom: calc(12px + env(safe-area-inset-bottom)); }



/* ---------- WeChat renderer stacking fix ---------- */
/* The DevTools/WeChat renderer paints the page and .phone backgrounds above a
   negative-z-index .wallpaper child, hiding every sibling. Keep the wallpaper
   as the bottom layer and make the two opaque backgrounds transparent. */
page { background: transparent; }
.phone { isolation: auto; background: transparent; }

/* ---------- company brand + three-toy entry ---------- */
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: calc(100% - 132rpx);
}
.brand-mark {
  flex: 0 0 auto;
  width: 200rpx;
  height: 61rpx;
  object-fit: contain;
  filter: drop-shadow(0 4rpx 8rpx rgba(30,50,90,.10));
}
/* The wordmark is navy on transparency; invert it on the dark themes so the
   company name stays legible instead of disappearing into the brown glass. */
.phone.dark .brand-mark {
  filter: brightness(0) invert(1);
  opacity: .92;
}
.brand-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding-left: 16rpx;
