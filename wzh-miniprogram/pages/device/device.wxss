/* ---------- mini program shell ---------- */
/* The native scroll-view caches its viewport when it is created. While the
   sheet slides up its flex height is still small, so the lower half of the
   console stays unpainted. Give it an explicit height instead of flex:1. */
.console-scroll { flex: none; height: calc(100vh - var(--menu-bottom, 86px) - 8px - 12rpx - 131rpx); }
page { width: 100%; height: 100%; overflow: hidden; }
.page, .stage, .phone-col, .phone-label, .under { display: none !important; }
.phone { width: 100vw; height: 100vh; border-radius: 0; box-shadow: none; --sheet-h: 654rpx; }
.sheet { top: auto; height: var(--sheet-h); bottom: 12rpx; }
.phone.expanded .sheet { top: 108rpx; height: auto; bottom: 12rpx; }
.phone.expanded .sheet-more.console { display: flex; }
.manual-sheet { top: 108rpx; bottom: 12rpx; }
.manual-frame { display: block; width: 100%; height: 100%; }
button { padding: 0; margin: 0; background: transparent; border: 0; line-height: inherit; font-size: inherit; color: inherit; text-align: inherit; overflow: visible; }
button::after { border: 0; }
input { border: 0; outline: none; }
.volume { position: relative; flex: 1; min-width: 0; height: 40rpx; }
.volume-track { position: absolute; left: 0; right: 0; top: 50%; height: 5rpx; margin-top: -2.5rpx; border-radius: 99rpx; background: rgba(47,40,34,.13); box-shadow: inset 0 1rpx 1rpx rgba(47,40,34,.10); }
.volume-fill { height: 100%; border-radius: 99rpx; background: var(--accent); }
.volume-thumb { position: absolute; top: 50%; width: 17rpx; height: 17rpx; margin: -8.5rpx 0 0 -8.5rpx; border: 2rpx solid rgba(255,255,255,.94); border-radius: 50%; background: #fffaf2; box-shadow: 0 2rpx 7rpx rgba(70,42,23,.24), 0 0 0 1rpx rgba(47,40,34,.05); }
.phone.dark .volume-track { background: rgba(255,255,255,.16); }
.tx-b { font-weight: 600; }
.tx-span, .tx-small, .tx-em, .tx-i { display: inline; }
.tx-em, .tx-i { font-style: normal; }
.tx-p { display: block; margin: 1em 0; }
.tx-h1, .tx-h2, .tx-h3, .tx-h4 { display: block; margin: .6em 0; font-weight: 650; }
.tx-label { display: block; }
.wifi-modal .modal-card { max-height: 84vh; }
.wifi-body { display: flex; flex-direction: column; gap: 10rpx; }
.wifi-current { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 12rpx; border: 1rpx solid var(--card-border); border-radius: 14rpx; background: var(--card-bg); }
.wifi-current .ico { width: 16rpx; height: 16rpx; color: var(--accent-deep); }
.wifi-current .tx-b { font-size: 12rpx; }
.wifi-current .tx-small { color: var(--ink-3); font-size: 8rpx; }
.wifi-scan-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 2rpx; }
.wifi-cap { color: var(--ink-3); font-size: 8rpx; letter-spacing: .08em; text-transform: uppercase; }
.wifi-rescan { display: inline-flex; align-items: center; gap: 4rpx; padding: 6rpx 10rpx; border: 1rpx solid var(--card-border); border-radius: 999rpx; color: var(--accent-deep); font-size: 9rpx; font-weight: 600; background: var(--card-bg); }
.wifi-rescan .ico { width: 12rpx; height: 12rpx; }
.wifi-list { display: flex; flex-direction: column; gap: 6rpx; max-height: 300rpx; overflow-y: auto; padding-right: 2rpx; }
.wifi-item { display: flex; align-items: center; gap: 8rpx; width: 100%; padding: 9rpx 10rpx; border: 1rpx solid var(--card-border); border-radius: 13rpx; background: var(--card-bg); text-align: left; }
.wifi-item.on { border-color: rgba(201,119,82,.66); box-shadow: 0 0 0 3rpx rgba(201,119,82,.10); }
.wifi-item .ico { width: 15rpx; height: 15rpx; color: var(--ink-2); }
.wifi-item-copy { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; flex: 1; }
.wifi-item-copy .tx-b { font-size: 11rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wifi-item-copy .tx-small { color: var(--ink-3); font-size: 8rpx; }
.wifi-item .signal-bars { flex: 0 0 auto; }
.wifi-badge { flex: 0 0 auto; padding: 2rpx 5rpx; border-radius: 5rpx; color: var(--ink-3); background: rgba(47,40,34,.06); font-size: 7rpx; }
.wifi-empty { padding: 16rpx 8rpx; color: var(--ink-3); font-size: 9rpx; text-align: center; }
