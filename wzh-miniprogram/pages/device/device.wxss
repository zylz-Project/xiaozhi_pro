  .orb-bubbles .tx-i:nth-child(8) { --bx: 87%; --by: 78%; --bs: 23.08rpx; --rise: 111.54rpx; --dx: -17.31rpx; --rot: -9deg; --dur: 5.6s; --morph: 4.4s; --delay: -1.7s; --bo: .46; }
