@import "../../styles/guide.wxss";
  page {
    --page-bg: #ece7df;
    --ink: #2f2822;
    --ink-soft: rgba(47, 40, 34, .66);
    --line: rgba(47, 40, 34, .10);
    --accent: #c97752;
    --accent-deep: #a95d3c;
    --green: #2f7d52;
    --amber: #b97722;
    --danger: #b74d3e;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  }

  page { margin: 0; min-height: 100%; }
  page {
    font-family: var(--font);
    color: var(--ink);
    background:
      radial-gradient(1730.77rpx 1000rpx at 18% -10%, rgba(255,255,255,.80), transparent 62%),
      radial-gradient(1538.46rpx 961.54rpx at 100% 8%, rgba(224,187,154,.24), transparent 60%),
      var(--page-bg);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  button, input { font: inherit; }
  button { -webkit-tap-highlight-color: transparent; }
  image { display: block; }
  .ico { /* mask icons */ }

  .page {
    width: min(2307.69rpx, 100%);
    margin: 0 auto;
    padding: 84.62rpx 80.77rpx 103.85rpx;
  }

  .page-head { margin-bottom: 61.54rpx; }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 19.23rpx;
    font-size: 19.23rpx;
    line-height: 1;
    letter-spacing: .16em;
    color: rgba(47,40,34,.48);
    text-transform: uppercase;
  }
  .eyebrow:before {
    content: "";
    width: 42.31rpx;
    height: 1.92rpx;
    background: rgba(47,40,34,.28);
  }
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 57.69rpx;
    margin-top: 25rpx;
  }
  .tx-h1 {
    margin: 0;
    font-size: 65.38rpx;
    line-height: 1.08;
    letter-spacing: -.045em;
    font-weight: 650;
  }
  .head-copy {
    margin: 17.31rpx 0 0;
    max-width: 1250rpx;
    font-size: 25rpx;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .head-copy .tx-b { color: var(--ink); font-weight: 600; }
  .variant-link {
    display: inline-flex;
    align-items: center;
    gap: 7.69rpx;
    min-height: 84.62rpx;
    margin-top: 7.69rpx;
    color: var(--accent-deep);
    font-size: 21.15rpx;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.92rpx;
    text-underline-offset: 7.69rpx;
  }
  .variant-link:hover { color: var(--ink); }

  .statebar {
    display: flex;
    flex-wrap: wrap;
    gap: 7.69rpx;
    padding: 7.69rpx;
    background: rgba(255,255,255,.52);
    border: 1.92rpx solid rgba(255,255,255,.78);
    border-radius: 1921.15rpx;
    box-shadow: 0 11.54rpx 34.62rpx -23.08rpx rgba(52,35,20,.28);
  }
  .statebar button {
    min-height: 59.62rpx;
    padding: 0 23.08rpx;
    border: 0;
    border-radius: 1921.15rpx;
    background: transparent;
    color: rgba(47,40,34,.56);
    font-size: 20.19rpx;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s ease, color .18s ease, box-shadow .18s ease;
  }
  .statebar button:hover { color: var(--ink); }
  .statebar button.on {
    color: #fffaf2;
    background: #352b24;
    box-shadow: 0 7.69rpx 23.08rpx -9.62rpx rgba(40,28,18,.55);
  }

  .stage {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 100rpx;
  }
  .phone-col { width: 750rpx; flex: 0 0 750rpx; }

  .phone-label {
    display: flex;
    align-items: center;
    gap: 15.38rpx;
    min-height: 57.69rpx;
    margin-bottom: 19.23rpx;
    padding-left: 5.77rpx;
  }
  .phone-label .tag {
    display: inline-grid;
    place-items: center;
    width: 40.38rpx;
    height: 40.38rpx;
    border-radius: 13.46rpx;
    background: rgba(255,255,255,.66);
    border: 1.92rpx solid rgba(255,255,255,.92);
    color: rgba(47,40,34,.62);
    font-size: 19.23rpx;
    font-weight: 700;
    box-shadow: 0 5.77rpx 19.23rpx -13.46rpx rgba(47,40,34,.35);
  }
  .phone-label .tag.rec {
    color: #fffaf2;
    background: #352b24;
    border-color: #352b24;
  }
  .phone-label .tx-b { font-size: 23.08rpx; font-weight: 650; letter-spacing: -.01em; }
  .phone-label .tx-em {
    margin-left: 3.85rpx;
    color: rgba(47,40,34,.48);
    font-size: 20.19rpx;
    font-style: normal;
  }
  .phone-label .rec-word {
    margin-left: 5.77rpx;
    color: var(--accent-deep);
    font-size: 18.27rpx;
    font-weight: 650;
    letter-spacing: .04em;
  }

  .under {
    margin: 19.23rpx 5.77rpx 0;
    font-size: 20.19rpx;
    line-height: 1.5;
    color: rgba(47,40,34,.44);
  }

  /* Phone shell */
  .phone {
    position: relative;
    width: 750rpx;
    height: 1623.08rpx;
    overflow: hidden;
    border-radius: 103.85rpx;
    isolation: isolate;
    background: var(--wall-1, #f7eadb);
    box-shadow:
      0 80.77rpx 173.08rpx -73.08rpx rgba(55,35,18,.46),
      0 3.85rpx 0 rgba(255,255,255,.86) inset,
      0 0 0 1.92rpx rgba(80,52,30,.08);
  }
  .phone.a {
    --glass-bg: rgba(255,255,255,.18);
    --glass-blur: 34.62rpx;
    --glass-border: rgba(255,255,255,.50);
    --card-bg: rgba(255,255,255,.21);
    --card-border: rgba(255,255,255,.42);
    --ink-2: rgba(47,40,34,.82);
    --ink-3: rgba(47,40,34,.58);
    --accent-soft: rgba(201,119,82,.14);
    --dial-core: rgba(255,255,255,.34);
  }
  .phone.b {
    --glass-bg: rgba(255,255,255,.50);
    --glass-blur: 61.54rpx;
    --glass-border: rgba(255,255,255,.78);
    --card-bg: rgba(255,255,255,.39);
    --card-border: rgba(255,255,255,.62);
    --ink-2: rgba(47,40,34,.70);
    --ink-3: rgba(47,40,34,.50);
    --accent-soft: rgba(201,119,82,.12);
    --dial-core: rgba(255,255,255,.62);
  }

  /* Theme palettes: material stays A/B, colours swap on the same phone. */
  .phone[data-theme="milk"] {
    --wall-glow: #fff6e8;
    --wall-1: #faefe2;
    --wall-2: #f2d2b6;
    --wall-3: #dbe5d6;
    --blob-1: #fff4df;
    --blob-2: #f2ad83;
    --blob-3: #b8d3bd;
    --blob-4: #f6c5a8;
    --blob-5: #ffe2c7;
    --accent: #c97752;
    --accent-deep: #a95d3c;
    --accent-soft: rgba(201,119,82,.14);
  }
  .phone[data-theme="salt"] {
    --wall-glow: #f4fbfa;
    --wall-1: #eef7f6;
    --wall-2: #cfe4e4;
    --wall-3: #e9dfcf;
    --blob-1: #eaf7f4;
    --blob-2: #8fbfc7;
    --blob-3: #b7d0b9;
    --blob-4: #e7c6a4;
    --blob-5: #dff0eb;
    --accent: #2f737e;
    --accent-deep: #215861;
    --accent-soft: rgba(47,115,126,.13);
  }
  .phone[data-theme="berry"] {
    --wall-glow: #fff6f8;
    --wall-1: #fbf2f4;
    --wall-2: #ecd3d8;
    --wall-3: #e8e0d1;
    --blob-1: #fff4f6;
    --blob-2: #d59aab;
    --blob-3: #b9c9b4;
    --blob-4: #edc0b4;
    --blob-5: #f7dde2;
    --accent: #b65f76;
    --accent-deep: #94475b;
    --accent-soft: rgba(182,95,118,.13);
  }
  .phone[data-theme="bamboo"] {
    --wall-glow: #fbfcef;
    --wall-1: #f7f7ea;
    --wall-2: #dfe6d2;
    --wall-3: #d7e2d7;
    --blob-1: #fbfcef;
    --blob-2: #a9c2a4;
    --blob-3: #c6d6b9;
    --blob-4: #d9c49e;
    --blob-5: #eaf0dc;
    --accent: #5f7f57;
    --accent-deep: #476340;
    --accent-soft: rgba(95,127,87,.13);
  }

  /* Wallpaper */
  .wallpaper {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background:
      radial-gradient(115% 76% at 18% 0%, var(--wall-glow, #fff6e8) 0%, rgba(255,246,232,0) 56%),
      linear-gradient(164deg, var(--wall-1, #faefe2) 0%, var(--wall-2, #f2d2b6) 46%, var(--wall-3, #dbe5d6) 100%);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(88.46rpx);
    pointer-events: none;
  }
  .b1 { width: 538.46rpx; height: 538.46rpx; left: -215.38rpx; top: -207.69rpx; background: var(--blob-1, #fff4df); opacity: .90; }
  .b2 { width: 586.54rpx; height: 586.54rpx; right: -240.38rpx; top: 188.46rpx; background: var(--blob-2, #f2ad83); opacity: .52; }
  .b3 { width: 615.38rpx; height: 615.38rpx; left: 42.31rpx; bottom: -242.31rpx; background: var(--blob-3, #b8d3bd); opacity: .76; }
  .b4 { width: 480.77rpx; height: 480.77rpx; right: -150rpx; bottom: 288.46rpx; background: var(--blob-4, #f6c5a8); opacity: .48; }
  .b5 { width: 326.92rpx; height: 326.92rpx; left: 307.69rpx; top: 384.62rpx; background: var(--blob-5, #ffe2c7); opacity: .40; filter: blur(73.08rpx); }
  .wallpaper:after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(100% 66% at 50% -2%, rgba(255,255,255,.47), transparent 62%),
      linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,0) 34%, rgba(65,40,20,.05));
  }

  /* Status + brand */
  .statusbar {
    position: absolute;
    top: 34.62rpx;
    left: 44.23rpx;
    right: 44.23rpx;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44.23rpx;
    color: rgba(47,40,34,.78);
  }
  .status-time {
    font-size: 23.08rpx;
    line-height: 1;
    font-weight: 650;
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 11.54rpx;
    min-height: 51.92rpx;
    padding: 0 17.31rpx;
    border-radius: 1921.15rpx;
    border: 1.92rpx solid rgba(255,255,255,.66);
    background: rgba(255,255,255,.36);
    box-shadow: 0 9.62rpx 26.92rpx -19.23rpx rgba(60,38,20,.32), inset 0 1.92rpx 0 rgba(255,255,255,.55);
    -webkit-backdrop-filter: blur(26.92rpx) saturate(160%);
    backdrop-filter: blur(26.92rpx) saturate(160%);
    font-size: 20rpx;
    font-weight: 650;
    letter-spacing: .01em;
    color: rgba(47,40,34,.80);
  }
  .status-dot {
    width: 9.62rpx;
    height: 9.62rpx;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 5.77rpx rgba(47,125,82,.12);
    animation: dotPulse 3.6s ease-in-out infinite;
  }
  .phone[data-state="listening"] .status-dot { background: #c97752; box-shadow: 0 0 0 5.77rpx rgba(201,119,82,.14); }
  .phone[data-state="speaking"] .status-dot { background: #b97722; box-shadow: 0 0 0 5.77rpx rgba(185,119,34,.14); }
  .phone[data-state="connecting"] .status-dot { background: var(--amber); box-shadow: 0 0 0 5.77rpx rgba(185,119,34,.14); }
  .phone[data-state="offline"] .status-dot { background: #8c8279; box-shadow: 0 0 0 5.77rpx rgba(90,78,66,.10); animation: none; }

  .brand {
    position: absolute;
    top: 100rpx;
    left: 44.23rpx;
    z-index: 9;
    transition: opacity .45s ease, filter .45s ease;
  }
  .brand .tx-b {
    display: block;
    font-size: 38.46rpx;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -.035em;
  }
  .brand .tx-span {
    display: block;
    margin-top: 7.69rpx;
    font-size: 17.31rpx;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .12em;
    color: rgba(47,40,34,.45);
  }

  /* Glass orb */
  .orb-wrap {
    position: absolute;
    top: 176.92rpx;
    left: 0;
    right: 0;
    height: 565.38rpx;
    z-index: 2;
    display: grid;
    place-items: center;
    transition: opacity .45s ease, filter .45s ease, transform .45s cubic-bezier(.2,.8,.2,1);
  }
  .orb-glow {
    position: absolute;
    width: 596.15rpx;
    height: 480.77rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,232,210,.62), rgba(255,232,210,0) 70%);
    filter: blur(34.62rpx);
    opacity: .8;
  }
  .orb-aurora {
    position: absolute;
    width: 550rpx;
    height: 550rpx;
    border-radius: 50%;
    background: conic-gradient(from 210deg, rgba(255,173,128,.22), rgba(255,244,227,.05) 24%, rgba(174,205,177,.20) 52%, rgba(255,215,178,.10) 72%, rgba(255,173,128,.22));
    filter: blur(42.31rpx);
    opacity: .52;
    animation: auroraSpin 18s linear infinite;
    pointer-events: none;
  }
  .orb-ripples {
    position: absolute;
    z-index: 0;
    width: 511.54rpx;
    height: 511.54rpx;
    pointer-events: none;
  }
  .orb-ripples .tx-i {
    position: absolute;
    inset: -1.92rpx;
    border: 3.08rpx solid rgba(211,120,72,.62);
    border-radius: 50%;
    opacity: 0;
    transform: scale(.96);
    box-shadow: 0 0 42.31rpx rgba(238,151,101,.16);
  }
  .orb-ripples .tx-i:nth-child(2) { animation-delay: .6s; }
  .orb-ripples .tx-i:nth-child(3) { animation-delay: 1.2s; }
  .phone[data-state="speaking"] .orb-ripples .tx-i { animation: orbRing 2.05s cubic-bezier(.16,.7,.24,1) infinite; }
  .phone[data-state="listening"] .orb-ripples .tx-i { animation: orbRing 3.2s cubic-bezier(.16,.7,.24,1) infinite; border-color: rgba(119,164,133,.40); }
  .phone[data-state="speaking"] .orb-aurora { opacity: .94; filter: blur(30.77rpx); animation: auroraSpin 8.5s linear infinite, auroraBreathe 1.7s ease-in-out infinite; }
  .phone[data-state="speaking"] .orb-glow { opacity: 1; filter: blur(23.08rpx); animation: glowPulse 1.55s ease-in-out infinite; }
  .phone[data-state="speaking"] .orb { animation: orbJelly 3.4s ease-in-out infinite; box-shadow: 0 65.38rpx 123.08rpx -53.85rpx rgba(92,52,24,.30), 0 0 0 1.92rpx rgba(255,251,245,.34) inset, 0 0 126.92rpx -34.62rpx rgba(234,132,83,.52), 0 -42.31rpx 73.08rpx -50rpx rgba(255,255,255,.74) inset; }
  .orb {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 511.54rpx;
    height: 511.54rpx;
    border-radius: 50%;
    border: 1.92rpx solid rgba(255,255,255,.64);
    background:
      radial-gradient(circle at 28% 16%, rgba(255,255,255,.62) 0%, rgba(255,255,255,.18) 26%, rgba(255,255,255,.06) 54%, rgba(255,255,255,.16) 100%);
    box-shadow:
      0 65.38rpx 123.08rpx -53.85rpx rgba(92,52,24,.30),
      0 3.85rpx 0 rgba(255,255,255,.82) inset,
      0 -42.31rpx 73.08rpx -50rpx rgba(255,255,255,.74) inset;
    -webkit-backdrop-filter: blur(32.69rpx) saturate(154%);
    backdrop-filter: blur(32.69rpx) saturate(154%);
    overflow: hidden;
  }
  .phone.a .orb { background: radial-gradient(circle at 28% 16%, rgba(255,255,255,.54) 0%, rgba(255,255,255,.10) 28%, rgba(255,255,255,.04) 58%, rgba(255,255,255,.12) 100%); }
  .phone.b .orb { background: radial-gradient(circle at 28% 16%, rgba(255,255,255,.68) 0%, rgba(255,255,255,.22) 28%, rgba(255,255,255,.08) 58%, rgba(255,255,255,.18) 100%); }
  .phone[data-state="speaking"] .orb { background: radial-gradient(circle at 50% 84%, rgba(255,178,128,.30), rgba(255,196,155,.10) 38%, transparent 66%), radial-gradient(circle at 28% 16%, rgba(255,255,255,.68) 0%, rgba(255,255,255,.22) 28%, rgba(255,255,255,.08) 58%, rgba(255,255,255,.18) 100%); }
  .orb:before {
    content: "";
    position: absolute;
    width: 80%;
    height: 52%;
    top: -12%;
    left: -10%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 42% 42%, rgba(255,255,255,.88), rgba(255,255,255,.22) 48%, transparent 72%);
    transform: rotate(-18deg);
    filter: blur(3.85rpx);
    opacity: .82;
    pointer-events: none;
  }
  .orb:after {
    content: "";
    position: absolute;
    inset: 17.31rpx;
    border-radius: inherit;
    border: 1.92rpx solid rgba(255,255,255,.30);
    box-shadow:
      inset 0 1.92rpx 0 rgba(255,255,255,.52),
      inset 0 -34.62rpx 57.69rpx -42.31rpx rgba(92,52,24,.22);
    pointer-events: none;
  }
  .orb-voice {
    position: absolute;
    z-index: 1;
    inset: 32.69rpx;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(circle at 50% 68%, rgba(255,177,132,.42), rgba(255,191,151,.10) 52%, transparent 72%);
    filter: blur(19.23rpx);
    pointer-events: none;
  }
  /* Speaking bubbles: .tx-small iridescent spheres drift out of the orb.
     They move, change shape and leave a soft trail instead of scaling the whole ball. */
  .orb-bubbles {
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    pointer-events: none;
  }
  .orb-bubbles .tx-i {
    position: absolute;
    left: var(--bx, 12%);
    top: var(--by, 30%);
    width: var(--bs, 46.15rpx);
    height: var(--bs, 46.15rpx);
    border: 1.92rpx solid rgba(255,255,255,.86);
    border-radius: 50% 44% 56% 48% / 46% 52% 48% 54%;
    background:
      radial-gradient(circle at 31% 25%, rgba(255,255,255,.96) 0 6%, rgba(255,255,255,.42) 18%, rgba(255,231,208,.26) 42%, rgba(255,255,255,.03) 74%),
      linear-gradient(145deg, rgba(255,211,177,.26), rgba(255,255,255,.02));
    box-shadow:
      inset 3.85rpx 5.77rpx 17.31rpx rgba(255,255,255,.94),
      inset -13.46rpx -15.38rpx 28.85rpx rgba(190,105,64,.22),
      inset 0 0 0 1.92rpx rgba(255,255,255,.18),
      0 0 0 1.92rpx rgba(255,255,255,.16),
      0 15.38rpx 38.46rpx -15.38rpx rgba(150,78,42,.32);
    opacity: 0;
    transform: translate3d(0, 46.15rpx, 0) scale(.8) rotate(-5deg);
    -webkit-backdrop-filter: blur(2.69rpx) saturate(145%);
    backdrop-filter: blur(2.69rpx) saturate(145%);
    will-change: transform, border-radius;
  }
  .orb-bubbles .tx-i::after {
    content: "";
    position: absolute;
    left: 19%;
    top: 14%;
    width: 27%;
    height: 18%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,.98), rgba(255,255,255,0) 72%);
    filter: blur(0.58rpx);
    transform: rotate(-28deg);
    pointer-events: none;
  }
  .orb-bubbles .tx-i:nth-child(1) { --bx: 2%; --by: 34%; --bs: 65.38rpx; --rise: 169.23rpx; --dx: 30.77rpx; --rot: 11deg; --dur: 7.2s; --morph: 6.4s; --delay: -1.2s; --bo: .72; }
  .orb-bubbles .tx-i:nth-child(2) { --bx: 75%; --by: 16%; --bs: 38.46rpx; --rise: 134.62rpx; --dx: -21.15rpx; --rot: -9deg; --dur: 6.1s; --morph: 5.2s; --delay: -3.4s; --bo: .64; background: radial-gradient(circle at 31% 25%, rgba(255,255,255,.96) 0 6%, rgba(255,255,255,.4) 20%, rgba(225,240,226,.24) 44%, rgba(255,255,255,.03) 76%); }
  .orb-bubbles .tx-i:nth-child(3) { --bx: 0%; --by: 66%; --bs: 30.77rpx; --rise: 107.69rpx; --dx: 25rpx; --rot: 8deg; --dur: 5.5s; --morph: 5.8s; --delay: -2.2s; --bo: .54; }
  .orb-bubbles .tx-i:nth-child(4) { --bx: 80%; --by: 58%; --bs: 51.92rpx; --rise: 146.15rpx; --dx: -28.85rpx; --rot: -12deg; --dur: 6.8s; --morph: 5.6s; --delay: -4.1s; --bo: .62; }
  .orb-bubbles .tx-i:nth-child(5) { --bx: 57%; --by: 82%; --bs: 26.92rpx; --rise: 123.08rpx; --dx: 13.46rpx; --rot: 10deg; --dur: 5.8s; --morph: 4.8s; --delay: -.8s; --bo: .5; }
